APP_NAME="Agenda Bacuri Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://agenda.bacuridigital.com
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bacuridi_agenda
DB_USERNAME=bacuridi_agapp
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# Instalação nova: escolha o fuso antes de cadastrar horários.
APP_TIMEZONE=UTC
